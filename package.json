{
  "name": "itty-router",
  "version": "5.0.21",
  "description": "A tiny, zero-dependency router, designed to make beautiful APIs in any environment.",
  "main": "./index.js",
  "module": "./index.mjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js"
    },
    "./AutoRouter": {
      "import": "./dist/AutoRouter.mjs",
      "types": "./dist/AutoRouter.d.ts",
      "require": "./dist/AutoRouter.js"
    },
    "./cors": {
      "import": "./dist/cors.mjs",
      "types": "./dist/cors.d.ts",
      "require": "./dist/cors.js"
    },
    "./createResponse": {
      "import": "./dist/createResponse.mjs",
      "types": "./dist/createResponse.d.ts",
      "require": "./dist/createResponse.js"
    },
    "./error": {
      "import": "./dist/error.mjs",
      "types": "./dist/error.d.ts",
      "require": "./dist/error.js"
    },
    "./html": {
      "import": "./dist/html.mjs",
      "types": "./dist/html.d.ts",
      "require": "./dist/html.js"
    },
    "./IttyRouter": {
      "import": "./dist/IttyRouter.mjs",
      "types": "./dist/IttyRouter.d.ts",
      "require": "./dist/IttyRouter.js"
    },
    "./jpeg": {
      "import": "./dist/jpeg.mjs",
      "types": "./dist/jpeg.d.ts",
      "require": "./dist/jpeg.js"
    },
    "./json": {
      "import": "./dist/json.mjs",
      "types": "./dist/json.d.ts",
      "require": "./dist/json.js"
    },
    "./png": {
      "import": "./dist/png.mjs",
      "types": "./dist/png.d.ts",
      "require": "./dist/png.js"
    },
    "./Router": {
      "import": "./dist/Router.mjs",
      "types": "./dist/Router.d.ts",
      "require": "./dist/Router.js"
    },
    "./status": {
      "import": "./dist/status.mjs",
      "types": "./dist/status.d.ts",
      "require": "./dist/status.js"
    },
    "./StatusError": {
      "import": "./dist/StatusError.mjs",
      "types": "./dist/StatusError.d.ts",
      "require": "./dist/StatusError.js"
    },
    "./text": {
      "import": "./dist/text.mjs",
      "types": "./dist/text.d.ts",
      "require": "./dist/text.js"
    },
    "./webp": {
      "import": "./dist/webp.mjs",
      "types": "./dist/webp.d.ts",
      "require": "./dist/webp.js"
    },
    "./websocket": {
      "import": "./dist/websocket.mjs",
      "types": "./dist/websocket.d.ts",
      "require": "./dist/websocket.js"
    },
    "./withContent": {
      "import": "./dist/withContent.mjs",
      "types": "./dist/withContent.d.ts",
      "require": "./dist/withContent.js"
    },
    "./withCookies": {
      "import": "./dist/withCookies.mjs",
      "types": "./dist/withCookies.d.ts",
      "require": "./dist/withCookies.js"
    },
    "./withParams": {
      "import": "./dist/withParams.mjs",
      "types": "./dist/withParams.d.ts",
      "require": "./dist/withParams.js"
    }
  },
  "keywords": [
    "api",
    "router",
    "cloudflare",
    "workers",
    "worker",
    "serverless",
    "cors",
    "middleware",
    "rest",
    "serviceworker",
    "nested"
  ],
  "scripts": {
    "dev": "bun test --watch --coverage",
    "test": "bun test --coverage",
    "lint": "itty lint",
    "build": "itty lint && itty build --hybrid",
    "release": "itty release --prepare --tag --push",
    "release:next": "itty release --prepare --tag --push --type=next"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kwhitley/itty-router.git"
  },
  "author": "Kevin R. Whitley <krwhitley@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/kwhitley/itty-router/issues"
  },
  "homepage": "https://itty.dev/itty-router",
  "devDependencies": {
    "@types/bun": "^1.2.17",
    "itty-packager": "^1.6.12"
  }
}
